# Signing secret for sessions and encrypted setting fields.
# Generate one with: openssl rand -base64 32
#
# ENGAGE_SECRET is the preferred name and is what the app config reads first.
ENGAGE_SECRET=

# Legacy name for the same secret. The config falls back to it, so existing
# deployments that only set this keep working.
#
# It cannot be dropped entirely: the underlying CMS engine's own CLI reads
# PAYLOAD_SECRET directly - before our config is evaluated - so `payload
# migrate` and `payload generate:*` still require it to be set. That is why the
# package.json scripts keep passing PAYLOAD_SECRET. Set both to the same value.
PAYLOAD_SECRET=

# Public site URL (used for sitemap.xml, robots.txt and canonical/OG URLs)
SITE_URL=https://example.com

# Stripe (ecommerce). Leave blank to deploy with the shop features disabled.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: debug | info | warn | error (defaults to info in production)
ENGAGE_LOG_LEVEL=
