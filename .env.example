# Signing secret for sessions and encrypted setting fields.
# Engine-level env var: the name PAYLOAD_SECRET is fixed by the underlying CMS
# engine and cannot be renamed. Generate one with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public site URL (used for sitemap.xml, robots.txt and canonical/OG URLs)
SITE_URL=https://example.com

# Stripe (ecommerce). Leave blank to deploy with the shop features disabled.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: debug | info | warn | error (defaults to info in production)
ENGAGE_LOG_LEVEL=
