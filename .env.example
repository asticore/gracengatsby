# Signing secret for sessions and encrypted setting fields.
# Generate one with: openssl rand -base64 32
#
# ENGAGE_SECRET is the preferred name and is what the app config reads first.
ENGAGE_SECRET=

# Legacy name for the same secret. Not required - leave blank.
#
# The underlying CMS engine's own CLI reads PAYLOAD_SECRET directly, before
# our config is evaluated, so `payload migrate`/`generate:*` still need it set
# at the OS-environment level. The package.json build/generate/cms scripts now
# derive it from ENGAGE_SECRET automatically when this is left blank, so you
# only need to set ENGAGE_SECRET above. Only fill this in if you deliberately
# want the two to differ (not recommended).
PAYLOAD_SECRET=

# Public site URL (used for sitemap.xml, robots.txt and canonical/OG URLs)
SITE_URL=https://example.com

# Stripe (ecommerce). Leave blank to deploy with the shop features disabled.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: debug | info | warn | error (defaults to info in production)
ENGAGE_LOG_LEVEL=

# Guards the four internal maintenance routes (/api/internal-migrate,
# /api/internal-seed, /api/internal-backup-run, /api/internal-backup-restore).
# None of them can drop or modify data, so this is not a security boundary -
# it just keeps crawlers and stray requests out. If unset, the app falls back
# to a retired default value so an install that hasn't set this yet still
# works rather than silently failing. Generate one with: openssl rand -hex 32
INTERNAL_ROUTE_KEY=
